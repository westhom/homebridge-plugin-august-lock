{
  "pluginAlias": "AugustLock",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": ["accountId", "accountPassword"],
    "additionalProperties": false,
    "properties": {
      "accountId": {
        "title": "August Account ID (phone or email)",
        "type": "string",
        "default": ""
      },
      "accountPassword": {
        "title": "August Account Password",
        "type": "string",
        "default": ""
      },
      "authCode": {
        "title": "August 2FA code",
        "type": "string",
        "default": ""
      }
    }
  }
}
